{
  "realm": "administration",
  "displayName": "Messagerie souveraine de l'administration",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "fr"
  ],
  "defaultLocale": "fr",
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "passwordPolicy": "length(12) and notUsername",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyCodeReusable": false,
  "otpSupportedApplications": [
    "totpAppFreeOTPName",
    "totpAppGoogleName",
    "totpAppMicrosoftAuthenticatorName"
  ],
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 36000,
  "accessTokenLifespan": 300,
  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "eventsListeners": [
    "jboss-logging"
  ],
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "LOGOUT",
    "LOGOUT_ERROR",
    "CODE_TO_TOKEN_ERROR",
    "UPDATE_TOTP",
    "REMOVE_TOTP",
    "UPDATE_PASSWORD",
    "UPDATE_CREDENTIAL",
    "REMOVE_CREDENTIAL"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "roles": {
    "realm": [
      {
        "name": "administrateur-securite",
        "description": "Accès à la console de sécurité : enrôlement, révocation, journal"
      }
    ]
  },
  "groups": [
    {
      "name": "agents",
      "path": "/agents",
      "attributes": {},
      "realmRoles": [],
      "clientRoles": {},
      "subGroups": []
    },
    {
      "name": "habilites-confidentiel",
      "path": "/habilites-confidentiel",
      "attributes": {},
      "realmRoles": [],
      "clientRoles": {},
      "subGroups": []
    }
  ],
  "scopeMappings": [
    {"client": "console-securite", "roles": ["administrateur-securite"]}
  ],
  "clientScopeMappings": {
    "realm-management": [
      {"client": "console-securite",
       "roles": ["manage-users", "view-users", "query-users", "query-groups", "view-events"]}
    ]
  },
  "clients": [
    {
      "clientId": "synapse",
      "fullScopeAllowed": false,
      "name": "Messagerie (serveur Synapse)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${SECRET_OIDC_SYNAPSE}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "${ADRESSE_PUBLIQUE}/_synapse/client/oidc/callback"
      ],
      "webOrigins": [
        "${ADRESSE_PUBLIQUE}"
      ],
      "frontchannelLogout": false,
      "attributes": {
        "backchannel.logout.url": "http://synapse:8008/_synapse/client/oidc/backchannel_logout",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "true",
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "profile",
        "roles",
        "basic"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "groupes",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "console-securite",
      "fullScopeAllowed": false,
      "name": "Console de sécurité",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${SECRET_OIDC_CONSOLE}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": [
        "${ADRESSE_PUBLIQUE}/console/connexion/retour"
      ],
      "webOrigins": [
        "${ADRESSE_PUBLIQUE}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${ADRESSE_PUBLIQUE}/console/"
      },
      "defaultClientScopes": [
        "profile",
        "roles",
        "basic"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "roles-du-royaume",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
