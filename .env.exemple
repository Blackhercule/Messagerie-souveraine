# Modèle du fichier .env. installer.sh le crée automatiquement avec des secrets ALÉATOIRES :
# ne recopiez pas ces valeurs d'exemple pour un vrai déploiement.

# Adresse de la machine : « localhost » ou son adresse IP sur le réseau local (ex. 192.168.1.20).
DOMAINE=localhost
PORT_HTTPS=8443
ADRESSE_PUBLIQUE=https://localhost:8443

# Nom du serveur dans les identifiants des agents : @awa.sawadogo:messagerie.local
NOM_SERVEUR_MATRIX=messagerie.local

MOT_DE_PASSE_POSTGRES=a-remplacer
MOT_DE_PASSE_ADMIN_KEYCLOAK=a-remplacer
SECRET_ENREGISTREMENT_SYNAPSE=a-remplacer
SECRET_MACAROON_SYNAPSE=a-remplacer
SECRET_FORMULAIRE_SYNAPSE=a-remplacer
SECRET_OIDC_SYNAPSE=a-remplacer
SECRET_OIDC_CONSOLE=a-remplacer
SECRET_SESSION_CONSOLE=a-remplacer
