# Configuration du serveur Synapse, produite au démarrage à partir de ce modèle
# (chaque $${VARIABLE} est remplacée par sa valeur du fichier .env, voir synapse/demarrer.py ;
# « $$$$ » s'écrit pour obtenir un « $$ »).

server_name: "${NOM_SERVEUR_MATRIX}"
public_baseurl: "${ADRESSE_PUBLIQUE}/"
pid_file: /data/homeserver.pid
signing_key_path: "/data/${NOM_SERVEUR_MATRIX}.signing.key"
log_config: "/data/log.config"
media_store_path: /data/media_store

listeners:
  - port: 8008
    type: http
    tls: false
    bind_addresses: ["0.0.0.0"]
    x_forwarded: true
    resources:
      # Seule l'API des applications est ouverte. Pas de « federation » :
      # le serveur ne parle à aucun autre serveur Matrix.
      - names: [client]
        compress: false

database:
  name: psycopg2
  args:
    user: synapse
    password: "${MOT_DE_PASSE_POSTGRES}"
    dbname: synapse
    host: postgres
    cp_min: 5
    cp_max: 10

# --------------------------------------------------------------- Souveraineté
# Aucun service extérieur : pas de fédération, pas de serveur de clés tiers,
# pas de statistiques envoyées, pas d'aperçu de liens (le serveur ne va chercher aucune page).
federation_domain_whitelist: []
trusted_key_servers: []
suppress_key_server_warning: true
report_stats: false
enable_metrics: false
url_preview_enabled: false

# --------------------------------------------------------------- Identité vérifiée
# Pas d'inscription libre, pas de mot de passe Synapse : on se connecte uniquement avec
# l'identité de l'administration (Keycloak : mot de passe + code TOTP).
enable_registration: false
allow_guest_access: false
password_config:
  enabled: false
registration_shared_secret: "${SECRET_ENREGISTREMENT_SYNAPSE}"
macaroon_secret_key: "${SECRET_MACAROON_SYNAPSE}"
form_secret: "${SECRET_FORMULAIRE_SYNAPSE}"

sso:
  client_whitelist:
    - "${ADRESSE_PUBLIQUE}/"
  update_profile_information: true

oidc_providers:
  - idp_id: administration
    idp_name: "Identité de l'administration"
    issuer: "${ADRESSE_PUBLIQUE}/auth/realms/administration"
    # Le navigateur passe par l'adresse publique ; le serveur, lui, joint Keycloak
    # directement dans le réseau Docker privé (http). La signature des jetons reste vérifiée.
    discover: false
    skip_verification: true
    authorization_endpoint: "${ADRESSE_PUBLIQUE}/auth/realms/administration/protocol/openid-connect/auth"
    token_endpoint: "http://keycloak:8080/auth/realms/administration/protocol/openid-connect/token"
    userinfo_endpoint: "http://keycloak:8080/auth/realms/administration/protocol/openid-connect/userinfo"
    jwks_uri: "http://keycloak:8080/auth/realms/administration/protocol/openid-connect/certs"
    client_id: synapse
    client_secret: "${SECRET_OIDC_SYNAPSE}"
    client_auth_method: client_secret_post
    # PKCE (RFC 7636) exigé par Keycloak : protège l'échange du code d'autorisation.
    pkce_method: always
    scopes: ["openid", "profile"]
    user_profile_method: userinfo_endpoint
    allow_existing_users: true
    # Seuls les membres du groupe « agents » (enrôlés par la console) peuvent entrer.
    attribute_requirements:
      - attribute: groups
        value: agents
    # Quand Keycloak ferme la session d'un agent (révocation), Synapse le déconnecte aussi.
    backchannel_logout_enabled: true
    user_mapping_provider:
      config:
        localpart_template: "{{ user.preferred_username }}"
        display_name_template: "{{ user.given_name }} {{ user.family_name }}"
        confirm_localpart: false

# --------------------------------------------------------------- Chiffrement
# Tous les salons sont chiffrés de bout en bout dès leur création.
encryption_enabled_by_default_for_room_type: all

# --------------------------------------------------------------- Métadonnées minimisées
presence:
  enabled: false
require_auth_for_profile_requests: true
user_directory:
  enabled: true
  search_all_users: true
  prefer_local_users: true
allow_public_rooms_without_auth: false
allow_public_rooms_over_federation: false
room_list_publication_rules:
  - action: deny
user_ips_max_age: 1d
redaction_retention_period: 1d
forgotten_room_retention_period: 1d
push:
  include_content: false

# Conservation : par défaut un an ; les salons classifiés expirent plus vite (module de sécurité).
retention:
  enabled: true
  default_policy:
    max_lifetime: 365d
  allowed_lifetime_min: 1h
  allowed_lifetime_max: 3650d
  purge_jobs:
    - longest_max_lifetime: 30d
      interval: 1h
    - shortest_max_lifetime: 30d
      interval: 1d

# --------------------------------------------------------------- Limites anti-abus
# Les essais de mots de passe et de codes TOTP sont bloqués par Keycloak (verrouillage après
# 5 échecs). Ici, la « connexion » n'échange qu'un jeton à usage unique délivré après Keycloak :
# la limite par adresse est assouplie pour les bureaux où beaucoup d'agents partagent une adresse IP.
rc_login:
  address: {per_second: 0.5, burst_count: 30}
  account: {per_second: 0.1, burst_count: 10}
  failed_attempts: {per_second: 0.1, burst_count: 5}
rc_message: {per_second: 0.5, burst_count: 25}
rc_room_creation: {per_second: 0.05, burst_count: 20}

max_upload_size: 50M
dynamic_thumbnails: false

# --------------------------------------------------------------- Module de sécurité
modules:
  - module: securite_messagerie.ModuleSecurite
    config:
      dossier_journal: /journal
      conservation_diffusion_restreinte: 30d
      conservation_confidentiel: 7d
