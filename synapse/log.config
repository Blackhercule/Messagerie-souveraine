version: 1

formatters:
  precis:
    format: "%(asctime)s - %(name)s - %(levelname)s - %(message)s"

handlers:
  console:
    class: logging.StreamHandler
    formatter: precis

loggers:
  synapse:
    level: INFO
  # Les journaux d'accès (adresses IP, horaires) ne sont pas conservés : moins de métadonnées.
  synapse.access.http.8008:
    level: WARNING
  securite_messagerie:
    level: INFO

root:
  level: INFO
  handlers: [console]

disable_existing_loggers: false
